    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.57.0",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.29",
    "radix-ui": "^1.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.90.0",
